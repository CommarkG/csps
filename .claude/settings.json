{
  "model": "claude-sonnet-4-6[1m]",
  "permissions": {
    "allow": [
      "WebFetch(domain:tag-app-delivery.cncf.io)",
      "WebFetch(domain:arc42.org)",
      "WebFetch(domain:sandimetz.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "Bash(pnpm verify *)",
      "Bash(pnpm verify)",
      "Bash(node tools/verify.mjs *)",
      "Bash(pnpm tokens:measure)",
      "Bash(bash .claude/hooks/verify-hooks-functional.sh)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": ".claude/hooks/user-prompt-submit-intake.sh"},
          {"type": "command", "command": ".claude/hooks/user-prompt-submit-governor-prompts.sh"},
          {"type": "command", "command": ".claude/hooks/verify-hooks-functional.sh"},
          {"type": "command", "command": ".claude/hooks/user-prompt-submit-context-orchestrator.sh"},
          {"type": "command", "command": ".claude/hooks/user-prompt-submit-next-step-reminder.sh"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/pre-tool-use-plan-coverage-gate.sh"},
          {"type": "command", "command": ".claude/hooks/pre-tool-use-frontmatter-enum-check.sh"},
          {"type": "command", "command": ".claude/hooks/pre-tool-use-skill-aap-required.sh"},
          {"type": "command", "command": ".claude/hooks/depth-marker-creation-gate.sh"}
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/pre-tool-use-plan-coverage-gate.sh"},
          {"type": "command", "command": ".claude/hooks/pre-tool-use-frontmatter-enum-check.sh"},
          {"type": "command", "command": ".claude/hooks/depth-marker-creation-gate.sh"}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/pre-tool-use-rzf-evidence-gate.sh"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {"type": "command", "command": ".claude/hooks/post-tool-use-validate-before-assume.sh"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": ".claude/hooks/post-stop-learning-loop.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-pcr-check.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-link-discipline.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-banned-phrase.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-pnpm-verify.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-consolidation-pass.sh"},
          {"type": "command", "command": ".claude/hooks/post-stop-savings-ssot-coverage.sh"}
        ]
      }
    ]
  }
}
