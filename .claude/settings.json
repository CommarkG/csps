{
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch(domain:tag-app-delivery.cncf.io)",
      "WebFetch(domain:arc42.org)",
      "WebFetch(domain:sandimetz.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "Bash(pnpm verify *)",
      "Bash(pnpm verify)",
      "Bash(node tools/verify.mjs *)",
      "Bash(pnpm tokens:measure)",
      "Bash(bash .claude/hooks/verify-hooks-functional.sh)",
      "Bash(cp \"c:\\\\Users\\\\finky\\\\Desktop\\\\Claude Code\\\\Csps\\\\tools\\\\scripts\\\\git-hooks\\\\pre-commit\" \"c:\\\\Users\\\\finky\\\\Desktop\\\\Claude Code\\\\Csps\\\\.git\\\\hooks\\\\pre-commit\" && echo \"copied\")"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "c:\\Users\\finky\\Desktop\\Claude Code\\Csps\\.git\\hooks",
      "c:\\Users\\finky\\Desktop\\csps-playground"
    ]
  },
  "model": "claude-sonnet-4-6[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-open.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-intake.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-governor-prompts.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/verify-hooks-functional.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-context-orchestrator.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-next-step-reminder.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-raw-comments.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-turn-counter.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-ai-profiler.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-sacred-parts-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-check-existing.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-vault-write-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-claude-dir-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-plan-coverage-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-frontmatter-enum-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-skill-aap-required.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/depth-marker-creation-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-claude-dir-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-plan-coverage-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-frontmatter-enum-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/depth-marker-creation-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-rzf-evidence-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use-agent-alignment.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use-validate-before-assume.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use-cec-trigger.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use-zf-level-gate.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use-validate-before-assume.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-session-close-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-learning-loop.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-pcr-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-link-discipline.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-banned-phrase.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-pnpm-verify.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-consolidation-pass.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-savings-ssot-coverage.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-rzf-reminder.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-stop-dna-sync-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
