# Line-ending normalization — CSPS parent repo
# Eliminates CRLF churn on Windows (imp_TRANSIENT_STOP_HOOK_K3 k=3 fix, S088-A1)
# P-META-019: k=3 mandatory structural fix. Source-level prevention > detection.
#
# RULE ORDER: git uses LAST MATCHING RULE. Submodule exclusion (apps/**) must be LAST.

# Default for all text files: auto-detect + normalize to LF
* text=auto

# Scripts + code: always LF (shebang breakage on deploy without this)
*.mjs  text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Data / config: LF for consistent YAML/JSON parsing
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
*.toml text eol=lf

# Binary — never alter
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.eot    binary
*.ttf    binary
*.zip    binary
*.pdf    binary
*.webp   binary
*.svg    text eol=lf

# SUBMODULES: -text (binary/no normalization) — MUST BE LAST (overrides all above rules).
# apps/** managed by submodule git repos with their own .gitattributes.
# Without this, parent's eol=lf normalization passes CRLF->LF during commit,
# causing validate-submodule-deliverable.mjs to fire false-positives in pre-commit.
apps/**  -text
