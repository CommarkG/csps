// CSPS Sandbox — Prisma Schema
// Source of truth for ZModel design: libs/policies/slices/public/
// When ZenStack is installed: replace this file with `zenstack generate` output.
// For now: hand-maintained mirror of the ZModel design for sandbox validation.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Foundation slices (from libs/policies/slices/public/) ─────────────────

model User {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clerkId     String    @unique
  email       String    @unique
  displayName String?
  staffRole   String?
  tenantId    String?   // active session context

  memberships UserTenant[]
  tasksCreated    Task[]    @relation("TaskCreatedBy")
  tasksAssigned   Task[]    @relation("TaskAssignee")
  comments        TaskComment[] @relation("TaskCommentAuthor")
}

model Tenant {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  slug             String    @unique
  name             String
  clerkOrgId       String?   @unique
  stripeCustomerId String?

  members          UserTenant[]
  projects         Project[]
  tasks            Task[]
  auditEvents      AuditEvent[]
}

model UserTenant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId    String
  tenantId  String
  role      MembershipRole

  user      User   @relation(fields: [userId], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model AuditEvent {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenantId     String
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  data         Json?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
}

// ─── Task management slices (from libs/policies/slices/public/) ─────────────

model Project {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenantId    String
  name        String
  description String?
  status      ProjectStatus @default(active)

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  tasks       Task[]

  @@index([tenantId, status])
}

model Task {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenantId    String
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(none)
  dueDate     DateTime?
  createdById String
  assigneeId  String?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments    TaskComment[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([projectId, status])
}

model TaskComment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  taskId    String
  authorId  String
  body      String

  task      Task @relation(fields: [taskId], references: [id])
  author    User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum MembershipRole {
  owner
  admin
  member
}

enum ProjectStatus {
  active
  archived
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  none
  low
  medium
  high
  urgent
}
