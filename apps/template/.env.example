# CSPS App Template — Environment Variables
# Copy to .env.local and fill in real values.
#
# CRITICAL: DATABASE_URL port 6543 MUST have ?pgbouncer=true&connection_limit=1
# Without it: "prepared statement s0 already exists" errors (INS-S022-002)

# DATABASE_URL — Supabase Supavisor transaction mode (for Vercel serverless)
# From: Supabase dashboard → Settings → Database → Connection pooling → Transaction mode
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL — direct connection (for migrations, prisma db push only)
# From: Supabase dashboard → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# Clerk Auth — https://dashboard.clerk.com
# After getting keys, ALSO configure in Clerk dashboard:
#   1. JWT template: {"tenantId": "{{user.public_metadata.tenantId}}", "role": "{{org.membership.role}}"}
#   2. Webhook URL: https://your-domain.com/api/webhooks/clerk (all events enabled)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── Anthropic AI (Claude API) ───────────────────────────────────────────────
# Required for any AI features (chat, analysis, document processing, etc.)
# Get key: https://console.anthropic.com → API Keys
# Model IDs: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Stripe Billing — https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TEAM_PRICE_ID="price_..."
# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Inngest (background jobs) ───────────────────────────────────────────────
INNGEST_SIGNING_KEY=signkey-prod-your-key-here
INNGEST_EVENT_KEY=your-event-key-here

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
POSTHOG_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://app.posthog.com

# ─── Cloudflare R2 (file storage) ────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=csps-uploads
CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com
