# app-manifest.yaml.example — copy to apps/{your-app}/app-manifest.yaml
# Required by P-ARCH-030 (apps are ephemeral trials) + validate-app-scope-isolation.mjs
# Every new app starts as a trial. Graduate when deletion_test: PASS + mrr_usd reached.

app_id: your-app-name          # matches apps/your-app-name/ directory
status: trial                  # trial | graduated | archived
trial_started: S0NN            # session number when app was created
platform_session: S0NN         # current session
live_url: https://csps-your-app.vercel.app

graduation_criteria:
  mrr_usd: 1000                # $1K MRR per B_COMPLETION_OVER_SHINY
  deletion_test: PENDING       # rm -rf apps/{app}/ must lose zero platform value
  component_b_complete: false  # all reusable patterns extracted to libs/

deletion_test_status:
  last_checked: YYYY-MM-DD
  result: PENDING              # PENDING | PASS | FAIL
  blockers: []                 # list what would be lost if app was deleted

component_b_extractions:
  # For each pattern discovered in this app, track extraction to platform
  # - pattern: name-of-pattern
  #   status: pending | documented | complete
  #   target: libs/path/to/where-it-belongs.ts

graduation_session: null       # set when mrr_usd reached + deletion_test: PASS

# ── HARDWIRE DNA INHERITANCE (S074 BATCH 7 — L4 DNA-at-birth) ────────────────
# Every new permanent thing in this app needs a satisfaction_point entry.
# Before claiming DONE on any app capability:
#   1. Check: is this thing in tools/data/satisfaction-point-registry.yaml?
#   2. If not, add an entry before claiming DONE.
#   3. SP verify_mechanically must exit 0.
# The HARDWIRE code word applies to app permanence too:
#   HARDWIRE [capability] = T1 BLOCKS + T2 exits-1 + T3 fires + block-test-pasted
hardwire_awareness:
  satisfaction_point_required: true   # every permanent capability needs an SP entry
  code_word: HARDWIRE                 # Governor uses this when permanence is required
  sp_registry: tools/data/satisfaction-point-registry.yaml
