// =============================================================================
// CSPS Platform Schema ג€” ZenStack Flat Assembly
// =============================================================================
// Machine-processable entry point for zenstack generate.
// Assembled from:
//   - libs/policies/base.zmodel           (datasource + Base mixin + enums)
//   - libs/policies/slices/public/*.zmodel (entity definitions + policies)
//
// Slice files remain as design documentation and source of truth for policies.
// THIS FILE is the ZenStack-processable artifact (flat = no circular imports).
//
// Run:    pnpm exec zenstack generate --schema libs/policies/schema.zmodel
// Output: libs/policies/generated/schema.prisma (for drift checking)
// Per:    B_PLATFORM_FIRST_OPTIMIZATION ג€” one schema for all 30 apps
//
// TEMPORARY FLAT ASSEMBLY (S017 cruel-critic finding CSEP-S017-001):
//   Multi-file ZenStack import approach has circular dependency issues with
//   bidirectional relations (Userג†”UserTenantג†”Tenant). Flat file is the
//   working workaround. Migration to multi-file when ZenStack resolves
//   circular imports or we establish import-ordering protocol (~30 models
//   is the merge-conflict threshold that forces this migration).
//   Tracked: VLT-S017-FLATSCHEMA
// =============================================================================

// ג”€ג”€ג”€ Datasource ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["public"]
}

// ג”€ג”€ג”€ Generators ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ג”€ג”€ג”€ ZenStack Plugins ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

// Generates standard Prisma schema from ZModel (drift check reference)
plugin prisma {
  provider = '@core/prisma'
  output   = './generated/schema.prisma'
}

// Generates enhanced Prisma client with runtime @@allow policy enforcement
plugin enhancer {
  provider  = '@core/enhancer'
  withPresets = true
}

// ג”€ג”€ג”€ Base Mixin ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€
// Every entity extends this. Provides id, timestamps, soft-delete.
// Per P-ARCH-007: hard delete denied by default.

abstract model Base {
  // S077 UUID migration: @db.Uuid restored on id.
  // Governor applies migration 20260602_uuid_native_types (ALTER COLUMN TYPE uuid USING ::uuid).
  // All values already conform (valid UUID v4 strings). Migration is data-preserving.
  // Deadline: 2026-06-16. Register: gap_DIM2_CORE_ID_UUID_UPGRADE.
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@deny('delete', true)
}

// Append-only entities (AuditEvent): no update, no delete, no soft-delete.
// Intentionally omits updatedAt + deletedAt ג€” immutability by schema.
abstract model AppendOnlyBase {
  // S077 UUID migration: @db.Uuid restored ג€” see Base comment above.
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  @@schema("public")
  @@deny("update,delete", true)
}

// ג”€ג”€ג”€ Common Enums ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

enum ActorKind {
  user
  admin
  system
  agent

  @@schema("public")
}

enum LifecycleState {
  active
  pendingReview    @map("pending-review")
  pendingProtocol  @map("pending-protocol")
  promoted
  resolved
  deprecated
  validated
  closed

  @@schema("public")
}

// ג”€ג”€ג”€ Foundation Slices ג€” Identity / Auth / Membership / Audit ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

// From: slices/public/tenant.zmodel
enum TenantSubscriptionStatus {
  // SEMANTIC (Governor S076): status = billing good-standing; plan = entitlement.
  // free-tier = status 'active' + planId null (no paid plan). 'free' is DEPRECATED as a status value.
  // DB migration needed to fully remove 'free' from the enum (defer to dim-4 UUID migration window).
  free        // DEPRECATED (S076): use status='active' + planId=null for free-tier tenants
  trialing    // 14-day trial when 2nd member joins before paying
  active      // billing good-standing ג€” free-tier (planId=null) OR paid (planId set)
  cancelled   // was paid, now cancelled; read-only until reactivated

  @@schema("public")
}

// From: slices/public/user-tenant.zmodel
enum MembershipRole {
  owner   // created the tenant; full control
  admin   // invited admin; can manage members + billing
  member  // standard member; app-level permissions only
  viewer  // read-only access; cannot create or modify anything

  @@schema("public")
}

// From: slices/public/user.zmodel
// Cross-tenant reads scoped to PUBLIC_USER_FIELDS via libs/integrations/security/user-projections.ts (PI-025)
model User extends Base {
  clerkId     String  @unique
  email       String  @unique
  displayName String?
  staffRole   String?
  tenantId    String? @db.Uuid  // denormalized default-tenant; no FK constraint ג€” ALTER COLUMN only

  memberships    UserTenant[]
  tasksCreated   Task[]         @relation("TaskCreatedBy")
  tasksAssigned  Task[]         @relation("TaskAssignee")
  comments       TaskComment[]  @relation("TaskCommentAuthor")
  notifications  Notification[] @relation("UserNotifications")

  @@schema("public")
  // Staff can read any user fully (admin operations)
  @@allow("read", auth().staffRole != null)
  // Users can read their own full profile
  @@allow("read", auth().id == id)
  // Cross-tenant read for task assignee/createdBy display.
  // ZenStack v2 limitation: @@allow fields scoping not supported; field-level scoping
  // deferred to ZenStack v3 or application-layer projection. Tracked: VLT-S029-FIELD-SCOPE.
  @@allow("read", auth().tenantId != null)
  @@allow("update", auth().id == id)  // users can only update their own profile
  // SEC-001: prevent non-staff from self-promoting staffRole (Opus Turn 23 security fix)
  @@deny("update", future().staffRole != staffRole && auth().staffRole == null)
  @@deny("create", true)              // created via Clerk webhook only (P-ARCH-008)
  @@deny("delete", true)

  @@index([clerkId])
  @@index([email])
}

// From: slices/public/tenant.zmodel
model Tenant extends Base {
  slug                 String                   @unique
  name                 String
  clerkOrgId           String?                  @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // S076: @default changed from free ג†’ active (Governor ratified: free-tier = active + planId null)
  subscriptionStatus   TenantSubscriptionStatus @default(active)
  // Plan tier ג€” separate from billing status (free/pro/enterprise/custom)
  plan                 String                   @default("free")
  // C3 fix (OPUS-16 S075): planId FK ג†’ Plan entity (PART 3 migration batch)
  // null = free tier. Coexists with plan:String field until planId FK migration complete.
  planId               String?  @db.Uuid  // already UUID in DB (PART 3 migration); schema alignment only
  planRelation         Plan?    @relation("TenantPlanFK", fields: [planId], references: [id])
  // Feature flags enabled for this tenant (e.g. ["ai-assist", "webhooks"])
  features             String[]                 @default([])
  // Resource limits override (null = use plan defaults)
  limits               Json?

  members           UserTenant[]
  projects          Project[]
  tasks             Task[]
  auditEvents       AuditEvent[]
  budgetCategories  BudgetCategory[]
  transactions      Transaction[]
  budgetGoal        BudgetGoal?
  notifications     Notification[]
  webhookEndpoints  WebhookEndpoint[]
  habits            Habit[]
  habitLogs         HabitLog[]
  journeys          Journey[]          // B.2 ג€” back-reference for ZenStack bidirectional requirement

  @@schema("public")
  @@allow("read", auth().tenantId == id)
  @@allow("read", auth().staffRole != null)
  @@deny("delete", true)

  @@index([slug])
  @@index([clerkOrgId])
}

// From: slices/public/user-tenant.zmodel
model UserTenant extends Base {
  userId   String @db.Uuid
  tenantId String @db.Uuid
  role     MembershipRole

  user   User   @relation(fields: [userId],   references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])

  @@schema("public")
  @@allow("read", auth().id == userId || auth().tenantId == tenantId)
  @@allow("read", auth().staffRole != null)
  // Write policies: membership changes require owner/admin ג€” enforced at API layer.
  // ZenStack auth() returns the User context (id, tenantId, staffRole) NOT UserTenant.role,
  // so role-gated create/update is implemented in libs/integrations/security/guards.ts
  // via checkMembershipPermission(userId, tenantId, requiredRole).
  // Staff can always manage memberships.
  @@allow("create", auth().staffRole != null)
  @@allow("update", auth().staffRole != null)
  @@deny("delete", true)

  @@index([userId])
  @@index([tenantId, role])
}

// From: slices/public/audit-event.zmodel
// Append-only: write via Postgres triggers only (P-ARCH-008)
model AuditEvent extends AppendOnlyBase {
  tenantId     String  @db.Uuid
  actorId      String? @db.Uuid  // references User.id; nullable (system actions have no actor)
  action       String
  resourceType String
  resourceId   String             // generic resource ג€” NOT a CSPS UUID FK; keep as TEXT
  data         Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@allow("read", auth().tenantId == tenantId)
  @@allow("read", auth().staffRole != null)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorId, createdAt])
}

// ג”€ג”€ג”€ App Slices ג€” Task Management ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

// From: slices/public/project.zmodel
enum ProjectStatus {
  active
  archived

  @@schema("public")
}

// From: slices/public/task.zmodel
enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@schema("public")
}

// From: slices/public/task.zmodel
enum TaskPriority {
  none
  low
  medium
  high
  urgent

  @@schema("public")
}

// From: slices/public/project.zmodel
model Project extends Base {
  tenantId    String @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(active)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tasks  Task[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)  // Q-04: any member; role enforcement at API layer via hasPermission()
  @@allow("update", auth().tenantId == tenantId)  // Q-05: admin+ enforced at API layer (ZenStack bypass active)
  @@deny("delete",  true)

  @@index([tenantId, status])
  @@index([tenantId, name])
}

// From: slices/public/task.zmodel
model Task extends Base {
  tenantId    String  @db.Uuid
  projectId   String? @db.Uuid
  title       String
  description String?
  status      TaskStatus    @default(todo)
  priority    TaskPriority  @default(none)
  dueDate     DateTime?
  createdById String  @db.Uuid
  assigneeId  String? @db.Uuid

  tenant    Tenant      @relation(fields: [tenantId],    references: [id])
  project   Project?    @relation(fields: [projectId],   references: [id])
  createdBy User        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee  User?       @relation("TaskAssignee",  fields: [assigneeId],  references: [id])
  comments  TaskComment[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([projectId, status])
  @@index([tenantId, dueDate])
}

// ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•
// APP #2 ג€” Budget Planner (personal.finance domain ג€” S025)
// Governor-authored intent: "track income and expenses, see balance"
// gate: Gate 3 Foundry Ready ג€” no foundation code changed
// ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•

// Budget category: income/expense classification with monthly limit
// AppendOnlyBase: soft-delete only (no hard delete)
model BudgetCategory extends Base {
  tenantId     String @db.Uuid
  name         String        // e.g. "Rent", "Food", "Salary"
  type         BudgetCategoryType  @default(expense)
  monthlyLimit Float?        // optional spending cap
  color        String?       // hex color for UI
  icon         String?       // emoji or icon name

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

// A single financial transaction (income or expense)
// AppendOnlyBase: immutable once recorded (financial integrity)
model Transaction extends Base {
  tenantId   String @db.Uuid
  categoryId String @db.Uuid
  amount     Float         // always positive; type determines direction
  type       BudgetCategoryType  // income or expense
  note       String?       // optional description
  date       DateTime      @default(now())

  tenant     Tenant         @relation(fields: [tenantId],   references: [id])
  category   BudgetCategory @relation(fields: [categoryId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@deny("update",  true)   // transactions are immutable (financial integrity)
  @@deny("delete",  true)

  @@index([tenantId, date])
  @@index([tenantId, categoryId])
  @@index([tenantId, type, date])
}

// Wizard completion record ג€” one per tenant, stores crystallized intent
// Created when user completes the 3 Threshold questions (the non-skippable gate)
// Human-authored fields: goal + targets (Q2c + Q3c from threshold-intake-protocol.md)
model BudgetGoal extends Base {
  tenantId      String  @unique @db.Uuid  // one goal per tenant (solo user = one per person)
  goalStatement String            // Q2c: "What would financial control look like in 30 days?"
  budgetTargets Json              // Q3c: [{categoryName, monthlyLimit}] ג€” human's own words
  completedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId])
}

enum BudgetCategoryType {
  income
  expense

  @@schema("public")
}

// ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•ג•
// From: slices/public/task-comment.zmodel
// Immutable once posted (no update); soft-delete via deletedAt only
model TaskComment extends Base {
  taskId   String @db.Uuid
  authorId String @db.Uuid
  body     String

  task   Task @relation(fields: [taskId],   references: [id])
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == task.tenantId)
  @@allow("create", auth().tenantId == task.tenantId)
  @@deny("update",  true)
  @@deny("delete",  true)

  @@index([taskId, createdAt])
}

// ג”€ג”€ג”€ Notification ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€
// Per-user, per-tenant notifications. Append-only (created by system triggers).
// Users can read and mark their own notifications as read.

model Notification extends Base {
  tenantId   String @db.Uuid
  userId     String @db.Uuid
  type       String    // e.g. "task.assigned", "mention", "system"
  title      String
  body       String
  readAt     DateTime?
  actionUrl  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId && auth().id == userId)
  @@allow("update", auth().id == userId)  // mark as read
  @@deny("create",  true)               // created via system triggers only
  @@deny("delete",  true)

  @@index([userId, createdAt])
  @@index([tenantId, userId, readAt])
}

// ג”€ג”€ג”€ WebhookEndpoint ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€
// Per-tenant webhook endpoints. Admin-level write via API guard; read for all members.
// ZenStack: staff-only write. API layer: checkMembership(['owner','admin']) enforces customer access.

// ג”€ג”€ Habit Tracker (App #2) ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

// A habit the user wants to track daily (e.g. "Exercise", "Read 20 minutes")
model Habit extends Base {
  tenantId String @db.Uuid
  name     String    // user-defined habit name
  logs     HabitLog[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",          auth().tenantId == tenantId)
  @@allow("create,update", auth().tenantId == tenantId)
  @@deny("delete",         true)  // soft-delete via deletedAt in Base

  @@index([tenantId, createdAt])
}

// A single day check-off for a habit ג€” one per habit per day
model HabitLog extends Base {
  habitId  String @db.Uuid
  tenantId String @db.Uuid
  date     DateTime  // date only ג€” store as midnight UTC of the day

  habit  Habit  @relation(fields: [habitId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("delete", auth().tenantId == tenantId)
  @@deny("update",  true)  // immutable ג€” delete and re-create to correct

  @@unique([habitId, date])  // one check per habit per day
  @@index([tenantId, date])
  @@index([habitId, date])
}

model WebhookEndpoint extends Base {
  tenantId        String @db.Uuid
  url             String
  secret          String    // HMAC signing secret ג€” never expose in read responses
  events          String[]  @default([])  // e.g. ["task.created", "member.added"]
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",          auth().tenantId == tenantId)
  // Staff-only in ZenStack; owner/admin enforced at API layer via checkMembership()
  @@allow("create,update", auth().tenantId == tenantId && auth().staffRole != null)
  @@deny("delete",         true)

  @@index([tenantId, active])
}

// ============================================================================
// PART 3 ג€” Product Schema (S075)
// Plan + Capability + PlanCapability
// NOTE: Tenant.planId FK is in the migration batch (separate gated step).
//       These models compile clean now. DB migration authorizated by Opus OPIA.
// ============================================================================

model Plan extends Base {
  slug            String   @unique
  name            String
  description     String?
  monthlyPriceUsd Decimal? @db.Decimal(10, 2)
  stripePriceId   String?

  tenants      Tenant[]         @relation("TenantPlanFK")  // C3 fix: back-reference now that Tenant.planId is in schema
  capabilities PlanCapability[]

  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([slug])
}

model Capability extends Base {
  slug        String   @unique
  name        String
  description String?
  category    String?
  deprecated  Boolean  @default(false)

  plans PlanCapability[]

  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([slug])
  @@index([category])
}

model PlanCapability extends Base {
  planId        String @db.Uuid  // already UUID in DB (PART 3); schema alignment only
  capabilityId  String @db.Uuid  // already UUID in DB (PART 3); schema alignment only
  limitValue    Int?

  plan       Plan       @relation(fields: [planId],       references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@unique([planId, capabilityId])
  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([planId])
  @@index([capabilityId])
}

// ג”€ג”€ג”€ Journey (B.2 schema slice) ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€
// Ratifiable from /platform/journey-admin dashboard.
// Governed write-back: ratify click ג†’ status draftג†’ratified in DB ג†’ SPEC.md updated.
// D1: Gap-Int ordering on JourneyStage.order (1000-gap seed; reorder = single UPDATE).
// D3: tenantId denormalized on both models for direct RLS (no join in policy expressions).
// D4: query cap enforced at API layer (ג‰₪50 journeys per GET).
// D5: single-include pattern: findMany({ include: { stages: { orderBy: { order: 'asc' } } } }).

enum JourneyType {
  developer
  user
  @@schema("public")
}

enum JourneyStatus {
  draft
  in_review  // Opus OPIA in progress ג€” not yet Governor-ratified
  ratified   // Governor C2 ratification complete
  sealed     // Permanent lock ג€” re-open only via boundary-crossing protocol
  @@schema("public")
}

model Journey extends Base {
  tenantId    String        @db.Uuid
  name        String
  type        JourneyType   @default(user)
  status      JourneyStatus @default(draft)
  description       String?
  ratifiedRiskClass RiskClass?    // F3 ג€” SET at P1 after R8 ratification; READ by SEED-2 gate_mode
  variant           VariantType?  // bound after selectVariant (SEED-6 R7)
  versionBinding    Json?         // InstanceVersionBinding ג€” the 6 def versions (SEED-9)
  stages            JourneyStage[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, type])
  @@index([tenantId, status])
}

model JourneyStage extends Base {
  tenantId     String  @db.Uuid        // D3: denormalized ג€” direct RLS, no join
  journeyId    String  @db.Uuid
  name         String
  description  String?
  order        Int                     // D1: Gap-Int (seed ֳ—1000 at insert); reorder = single UPDATE
  exitCriteria String?
  buildStatus  String  @default("PLANNED")  // ACTIVE | PLANNED ג€” mirrors developer-journey page
  variants     Json?                   // per-stage variant overrides (admin-config-heavy etc.)

  journey Journey @relation(fields: [journeyId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, journeyId, order])  // D5: covers include+orderBy in one index
  @@index([journeyId, order])            // D1: covers single-UPDATE reorder queries
}

// ג”€ג”€ Journey Orchestrator: closed enums (SEED-6) ג€” Sonnet S084 B1 ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€

enum DefinitionScope {
  platform_def
  tenant_def   // F2 ג€” definition OWNERSHIP, NOT instance tenant_id; tenant_def LOCKED OUT in MVP (C5)
  @@schema("public")
}

enum RiskClass {
  low
  standard
  elevated
  critical
  // SEED-6 selector primary output; SET at P1 after R8 ratification; READ by SEED-2 gate_mode at every PEG
  @@schema("public")
}

enum VariantType {
  fast
  standard     // low->fast ֲ· standard->standard ֲ· elevated/critical->governed
  governed
  exploratory  // F1: explicit opt-in only (never auto); permission floor: core_dev+
  @@schema("public")
}

enum GateModeValue {
  blocking
  advisory
  silent
  // SEED-2 gate_mode matrix cell values
  @@schema("public")
}

enum PolicyResult {
  allow
  deny
  warn
  require_approval
  auto_upgrade
  // R4 policy-evaluation result ג€” single admission-controller boundary (SEED-2)
  @@schema("public")
}

enum RippleSeverity {
  P0
  P1
  P2
  P3
  // SEED-4 blast-radius severity: P0/P1 block activation, P2 ticket, P3 log
  @@schema("public")
}

enum ChangeClass {
  none
  advisory
  required_before_next_peg
  forced_before_activation
  legacy_continues
  // SEED-9 definition versioning change classification (in-flight instance migration)
  @@schema("public")
}

// ג”€ג”€ Journey Meta-Model (SEED-1/2/3/6) ג€” Sonnet S084 B1 ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€ג”€
// Platform-level DEFINITION rows (no tenant scope ג€” these are definition templates, not instances).
// Any authenticated user reads; staff (staffRole != null) creates/updates.
// Hard delete denied by Base; platform definitions are permanent references.

model PhaseDef extends Base {
  phaseId     String  @unique    // P1 | P2 | P3 | P4 | P5
  name        String
  intent      String
  moats       Json?              // SEED-3: moat list for this phase (M-NN slugs)
  councilType String?            // SEED-3: inner | expert | external
  loopEmits   String?            // SEED-3: alignment | optimization | anti-drift

  gates       GateDef[]

  @@schema("public")
  @@allow("read",          auth() != null)
  @@allow("create,update", auth().staffRole != null)
}

model GateDef extends Base {
  pegId                  String        @unique   // PEG-1 | PEG-2 | PEG-3 | PEG-4 | PEG-5
  phaseDefId             String        @db.Uuid
  minimumExitEvidence    Json?                   // evidence contracts (SEED-5)
  gateModeMatrix         Json                    // RiskClassֳ—Phase matrix VERBATIM from SEED-2 F4
  zfGateMode             GateModeValue @default(blocking)
  zfGateProof            String        @default("rerun")  // rerun | hashverify
  thresholdRequired      Boolean       @default(true)
  peRequired             Boolean       @default(false)    // true only at PEG-3 (decide)
  cieEmit                Boolean       @default(true)     // always emits; never silent per SEED-2 matrix
  policyRef              String?
  blockedMessageTemplate Json?                           // BlockedMessage template (SEED-2)

  phaseDef PhaseDef @relation(fields: [phaseDefId], references: [id])

  @@schema("public")
  @@allow("read",          auth() != null)
  @@allow("create,update", auth().staffRole != null)
}

model VariantDef extends Base {
  variantType     VariantType @unique
  displayName     String
  riskClassFloor  RiskClass              // minimum risk class that maps to this variant
  description     String?
  gateRelaxations Json?                 // permitted gate relaxations within trunk floors (SEED-2)

  @@schema("public")
  @@allow("read",          auth() != null)
  @@allow("create,update", auth().staffRole != null)
}

model BranchAxisBinding extends Base {
  axisId      String       // SEED-6 BranchAxis: depth | drive_auto | vocabulary | permission | focal
  variantType VariantType
  axisValue   String       // axis setting for this variant
  description String?

  @@schema("public")
  @@unique([axisId, variantType])
  @@allow("read",          auth() != null)
  @@allow("create,update", auth().staffRole != null)
}

// ── B4 S085: SEED-2/6 schema additions (db-push deferred to 2026-06-27 PARK-009) ────────────

// SEED-6: PersonaTier — 6-tier permission overlay (from journeys.tier_permission in core-spine-registry)
// Controls who can view/modify trunk, create journeys, ratify risk class, exploratory opt-in.
enum PersonaTier {
  governor           // full access: modify trunk, ratify risk class, exploratory opt-in
  core_dev           // create journeys; exploratory opt-in (permission floor F1); no trunk modify
  external_dev       // create journeys within assigned scope; no exploratory
  account_owner_admin // summary view only; no journey create
  team_leader        // no trunk view; no journey create
  end_user           // no trunk view; no journey create
  // R8 ratification interface: min_tier_to_ratify = governor
  @@schema("public")
}

// SEED-6: BranchAxisType — 5 typed branch axes (replaces string axisId in BranchAxisBinding)
// Controls how a variant shapes the journey (depth, drive style, vocabulary, permissions, scope)
enum BranchAxisType {
  depth          // depth-of-work: surface | standard | deep | comprehensive
  drive_auto     // drive_auto: true (AI leads) | false (human leads)
  vocabulary     // vocabulary: technical | business | mixed
  permission     // permission: open | gated | restricted
  focal          // focal_point: build | audit | decide | validate | learn
  @@schema("public")
}

