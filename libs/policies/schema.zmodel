// =============================================================================
// CSPS Platform Schema — ZenStack Flat Assembly
// =============================================================================
// Machine-processable entry point for zenstack generate.
// Assembled from:
//   - libs/policies/base.zmodel           (datasource + Base mixin + enums)
//   - libs/policies/slices/public/*.zmodel (entity definitions + policies)
//
// Slice files remain as design documentation and source of truth for policies.
// THIS FILE is the ZenStack-processable artifact (flat = no circular imports).
//
// Run:    pnpm exec zenstack generate --schema libs/policies/schema.zmodel
// Output: libs/policies/generated/schema.prisma (for drift checking)
// Per:    B_PLATFORM_FIRST_OPTIMIZATION — one schema for all 30 apps
//
// TEMPORARY FLAT ASSEMBLY (S017 cruel-critic finding CSEP-S017-001):
//   Multi-file ZenStack import approach has circular dependency issues with
//   bidirectional relations (User↔UserTenant↔Tenant). Flat file is the
//   working workaround. Migration to multi-file when ZenStack resolves
//   circular imports or we establish import-ordering protocol (~30 models
//   is the merge-conflict threshold that forces this migration).
//   Tracked: VLT-S017-FLATSCHEMA
// =============================================================================

// ─── Datasource ──────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["public"]
}

// ─── Generators ──────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ─── ZenStack Plugins ────────────────────────────────────────────────────────

// Generates standard Prisma schema from ZModel (drift check reference)
plugin prisma {
  provider = '@core/prisma'
  output   = './generated/schema.prisma'
}

// Generates enhanced Prisma client with runtime @@allow policy enforcement
plugin enhancer {
  provider  = '@core/enhancer'
  withPresets = true
}

// ─── Base Mixin ──────────────────────────────────────────────────────────────
// Every entity extends this. Provides id, timestamps, soft-delete.
// Per P-ARCH-007: hard delete denied by default.

abstract model Base {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@deny('delete', true)
}

// Append-only entities (AuditEvent): no update, no delete, no soft-delete.
// Intentionally omits updatedAt + deletedAt — immutability by schema.
abstract model AppendOnlyBase {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  @@schema("public")
  @@deny("update,delete", true)
}

// ─── Common Enums ─────────────────────────────────────────────────────────────

enum ActorKind {
  user
  admin
  system
  agent

  @@schema("public")
}

enum LifecycleState {
  active
  pendingReview    @map("pending-review")
  pendingProtocol  @map("pending-protocol")
  promoted
  resolved
  deprecated
  validated
  closed

  @@schema("public")
}

// ─── Foundation Slices — Identity / Auth / Membership / Audit ─────────────────

// From: slices/public/tenant.zmodel
enum TenantSubscriptionStatus {
  free        // solo use — free forever (VLT-S014-005)
  trialing    // 14-day trial when 2nd member joins before paying
  active      // paid — 2+ members, Stripe subscription active
  cancelled   // was paid, now cancelled; read-only until reactivated

  @@schema("public")
}

// From: slices/public/user-tenant.zmodel
enum MembershipRole {
  owner   // created the tenant; full control
  admin   // invited admin; can manage members + billing
  member  // standard member; app-level permissions only
  viewer  // read-only access; cannot create or modify anything

  @@schema("public")
}

// From: slices/public/user.zmodel
// Cross-tenant reads scoped to PUBLIC_USER_FIELDS via libs/integrations/security/user-projections.ts (PI-025)
model User extends Base {
  clerkId     String  @unique
  email       String  @unique
  displayName String?
  staffRole   String?
  tenantId    String?

  memberships    UserTenant[]
  tasksCreated   Task[]         @relation("TaskCreatedBy")
  tasksAssigned  Task[]         @relation("TaskAssignee")
  comments       TaskComment[]  @relation("TaskCommentAuthor")
  notifications  Notification[] @relation("UserNotifications")

  @@schema("public")
  // Staff can read any user fully (admin operations)
  @@allow("read", auth().staffRole != null)
  // Users can read their own full profile
  @@allow("read", auth().id == id)
  // Cross-tenant read for task assignee/createdBy display.
  // ZenStack v2 limitation: @@allow fields scoping not supported; field-level scoping
  // deferred to ZenStack v3 or application-layer projection. Tracked: VLT-S029-FIELD-SCOPE.
  @@allow("read", auth().tenantId != null)
  @@allow("update", auth().id == id)  // users can only update their own profile
  // SEC-001: prevent non-staff from self-promoting staffRole (Opus Turn 23 security fix)
  @@deny("update", future().staffRole != staffRole && auth().staffRole == null)
  @@deny("create", true)              // created via Clerk webhook only (P-ARCH-008)
  @@deny("delete", true)

  @@index([clerkId])
  @@index([email])
}

// From: slices/public/tenant.zmodel
model Tenant extends Base {
  slug                 String                   @unique
  name                 String
  clerkOrgId           String?                  @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   TenantSubscriptionStatus @default(free)
  // Plan tier — separate from billing status (free/pro/enterprise/custom)
  plan                 String                   @default("free")
  // Feature flags enabled for this tenant (e.g. ["ai-assist", "webhooks"])
  features             String[]                 @default([])
  // Resource limits override (null = use plan defaults)
  limits               Json?

  members           UserTenant[]
  projects          Project[]
  tasks             Task[]
  auditEvents       AuditEvent[]
  budgetCategories  BudgetCategory[]
  transactions      Transaction[]
  budgetGoal        BudgetGoal?
  notifications     Notification[]
  webhookEndpoints  WebhookEndpoint[]
  habits            Habit[]
  habitLogs         HabitLog[]

  @@schema("public")
  @@allow("read", auth().tenantId == id)
  @@allow("read", auth().staffRole != null)
  @@deny("delete", true)

  @@index([slug])
  @@index([clerkOrgId])
}

// From: slices/public/user-tenant.zmodel
model UserTenant extends Base {
  userId   String
  tenantId String
  role     MembershipRole

  user   User   @relation(fields: [userId],   references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])

  @@schema("public")
  @@allow("read", auth().id == userId || auth().tenantId == tenantId)
  @@allow("read", auth().staffRole != null)
  // Write policies: membership changes require owner/admin — enforced at API layer.
  // ZenStack auth() returns the User context (id, tenantId, staffRole) NOT UserTenant.role,
  // so role-gated create/update is implemented in libs/integrations/security/guards.ts
  // via checkMembershipPermission(userId, tenantId, requiredRole).
  // Staff can always manage memberships.
  @@allow("create", auth().staffRole != null)
  @@allow("update", auth().staffRole != null)
  @@deny("delete", true)

  @@index([userId])
  @@index([tenantId, role])
}

// From: slices/public/audit-event.zmodel
// Append-only: write via Postgres triggers only (P-ARCH-008)
model AuditEvent extends AppendOnlyBase {
  tenantId     String
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  data         Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@allow("read", auth().tenantId == tenantId)
  @@allow("read", auth().staffRole != null)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorId, createdAt])
}

// ─── App Slices — Task Management ─────────────────────────────────────────────

// From: slices/public/project.zmodel
enum ProjectStatus {
  active
  archived

  @@schema("public")
}

// From: slices/public/task.zmodel
enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@schema("public")
}

// From: slices/public/task.zmodel
enum TaskPriority {
  none
  low
  medium
  high
  urgent

  @@schema("public")
}

// From: slices/public/project.zmodel
model Project extends Base {
  tenantId    String
  name        String
  description String?
  status      ProjectStatus @default(active)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tasks  Task[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)  // Q-04: any member; role enforcement at API layer via hasPermission()
  @@allow("update", auth().tenantId == tenantId)  // Q-05: admin+ enforced at API layer (ZenStack bypass active)
  @@deny("delete",  true)

  @@index([tenantId, status])
  @@index([tenantId, name])
}

// From: slices/public/task.zmodel
model Task extends Base {
  tenantId    String
  projectId   String?
  title       String
  description String?
  status      TaskStatus    @default(todo)
  priority    TaskPriority  @default(none)
  dueDate     DateTime?
  createdById String
  assigneeId  String?

  tenant    Tenant      @relation(fields: [tenantId],    references: [id])
  project   Project?    @relation(fields: [projectId],   references: [id])
  createdBy User        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee  User?       @relation("TaskAssignee",  fields: [assigneeId],  references: [id])
  comments  TaskComment[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([projectId, status])
  @@index([tenantId, dueDate])
}

// ═══════════════════════════════════════════════════════════════
// APP #2 — Budget Planner (personal.finance domain — S025)
// Governor-authored intent: "track income and expenses, see balance"
// gate: Gate 3 Foundry Ready — no foundation code changed
// ═══════════════════════════════════════════════════════════════

// Budget category: income/expense classification with monthly limit
// AppendOnlyBase: soft-delete only (no hard delete)
model BudgetCategory extends Base {
  tenantId     String
  name         String        // e.g. "Rent", "Food", "Salary"
  type         BudgetCategoryType  @default(expense)
  monthlyLimit Float?        // optional spending cap
  color        String?       // hex color for UI
  icon         String?       // emoji or icon name

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

// A single financial transaction (income or expense)
// AppendOnlyBase: immutable once recorded (financial integrity)
model Transaction extends Base {
  tenantId   String
  categoryId String
  amount     Float         // always positive; type determines direction
  type       BudgetCategoryType  // income or expense
  note       String?       // optional description
  date       DateTime      @default(now())

  tenant     Tenant         @relation(fields: [tenantId],   references: [id])
  category   BudgetCategory @relation(fields: [categoryId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@deny("update",  true)   // transactions are immutable (financial integrity)
  @@deny("delete",  true)

  @@index([tenantId, date])
  @@index([tenantId, categoryId])
  @@index([tenantId, type, date])
}

// Wizard completion record — one per tenant, stores crystallized intent
// Created when user completes the 3 Threshold questions (the non-skippable gate)
// Human-authored fields: goal + targets (Q2c + Q3c from threshold-intake-protocol.md)
model BudgetGoal extends Base {
  tenantId      String  @unique  // one goal per tenant (solo user = one per person)
  goalStatement String            // Q2c: "What would financial control look like in 30 days?"
  budgetTargets Json              // Q3c: [{categoryName, monthlyLimit}] — human's own words
  completedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("update", auth().tenantId == tenantId)
  @@deny("delete",  true)

  @@index([tenantId])
}

enum BudgetCategoryType {
  income
  expense

  @@schema("public")
}

// ═══════════════════════════════════════════════════════════════
// From: slices/public/task-comment.zmodel
// Immutable once posted (no update); soft-delete via deletedAt only
model TaskComment extends Base {
  taskId   String
  authorId String
  body     String

  task   Task @relation(fields: [taskId],   references: [id])
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == task.tenantId)
  @@allow("create", auth().tenantId == task.tenantId)
  @@deny("update",  true)
  @@deny("delete",  true)

  @@index([taskId, createdAt])
}

// ─── Notification ──────────────────────────────────────────────────────────────
// Per-user, per-tenant notifications. Append-only (created by system triggers).
// Users can read and mark their own notifications as read.

model Notification extends Base {
  tenantId   String
  userId     String
  type       String    // e.g. "task.assigned", "mention", "system"
  title      String
  body       String
  readAt     DateTime?
  actionUrl  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId && auth().id == userId)
  @@allow("update", auth().id == userId)  // mark as read
  @@deny("create",  true)               // created via system triggers only
  @@deny("delete",  true)

  @@index([userId, createdAt])
  @@index([tenantId, userId, readAt])
}

// ─── WebhookEndpoint ───────────────────────────────────────────────────────────
// Per-tenant webhook endpoints. Admin-level write via API guard; read for all members.
// ZenStack: staff-only write. API layer: checkMembership(['owner','admin']) enforces customer access.

// ── Habit Tracker (App #2) ───────────────────────────────────────────────

// A habit the user wants to track daily (e.g. "Exercise", "Read 20 minutes")
model Habit extends Base {
  tenantId String
  name     String    // user-defined habit name
  logs     HabitLog[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",          auth().tenantId == tenantId)
  @@allow("create,update", auth().tenantId == tenantId)
  @@deny("delete",         true)  // soft-delete via deletedAt in Base

  @@index([tenantId, createdAt])
}

// A single day check-off for a habit — one per habit per day
model HabitLog extends Base {
  habitId  String
  tenantId String
  date     DateTime  // date only — store as midnight UTC of the day

  habit  Habit  @relation(fields: [habitId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",   auth().tenantId == tenantId)
  @@allow("create", auth().tenantId == tenantId)
  @@allow("delete", auth().tenantId == tenantId)
  @@deny("update",  true)  // immutable — delete and re-create to correct

  @@unique([habitId, date])  // one check per habit per day
  @@index([tenantId, date])
  @@index([habitId, date])
}

model WebhookEndpoint extends Base {
  tenantId        String
  url             String
  secret          String    // HMAC signing secret — never expose in read responses
  events          String[]  @default([])  // e.g. ["task.created", "member.added"]
  active          Boolean   @default(true)
  lastTriggeredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
  @@allow("read",          auth().tenantId == tenantId)
  // Staff-only in ZenStack; owner/admin enforced at API layer via checkMembership()
  @@allow("create,update", auth().tenantId == tenantId && auth().staffRole != null)
  @@deny("delete",         true)

  @@index([tenantId, active])
}

// ============================================================================
// PART 3 — Product Schema (S075)
// Plan + Capability + PlanCapability
// NOTE: Tenant.planId FK is in the migration batch (separate gated step).
//       These models compile clean now. DB migration authorizated by Opus OPIA.
// ============================================================================

model Plan extends Base {
  slug            String   @unique
  name            String
  description     String?
  monthlyPriceUsd Decimal? @db.Decimal(10, 2)
  stripePriceId   String?

  // tenants Tenant[] — back-reference added when Tenant.planId FK migration is authorized
  capabilities PlanCapability[]

  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([slug])
}

model Capability extends Base {
  slug        String   @unique
  name        String
  description String?
  category    String?
  deprecated  Boolean  @default(false)

  plans PlanCapability[]

  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([slug])
  @@index([category])
}

model PlanCapability extends Base {
  planId        String
  capabilityId  String
  limitValue    Int?

  plan       Plan       @relation(fields: [planId],       references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@unique([planId, capabilityId])
  @@schema("public")
  @@allow("read", true)
  @@allow("create,update", auth().staffRole != null)
  @@deny("delete", true)
  @@index([planId])
  @@index([capabilityId])
}
