// ============================================================================
// Tenant — Foundation slice for product-context / multi-tenancy plane
// ============================================================================
// The CSPS product context. One Tenant per Clerk organization (1:1 per
// VLT-S011-004). Tenant.clerkOrgId = Clerk org ID — direct mapping, no
// intermediate join table until flexibility is proven necessary (P-OP-003).
//
// Stripe integration: stripeCustomerId populated in S013 (billing wiring).
// Billing status: subscriptionStatus tracks free/paid tier per VLT-S015-002.
// Hard delete forbidden per P-ARCH-007.
//
// VLT-S015-002 resolved: subscriptionStatus = free|trialing|active|cancelled (4 values).
// Billing trigger: status changes when 2nd UserTenant joins (VLT-S014-005 free→paid).
//
// Source of truth: libs/policies/slices/public/foundation-design.md §VLT-S011-004
// ============================================================================

import "../base"

@@meta(
  id: "csps.public.tenant",
  domain: "identity",
  type: "schema",
  audience: "developer",
  enforces: ["P-ARCH-002", "P-ARCH-007"],
  lifecycle: "production",
  lifecycle_state: "active"
)

enum TenantSubscriptionStatus {
  free        // solo use — free forever (VLT-S014-005)
  trialing    // 14-day trial when 2nd member joins before paying
  active      // paid — 2+ members, Stripe subscription active
  cancelled   // was paid, now cancelled; read-only until reactivated
}

model Tenant extends Base {
  slug                 String                    @unique
  name                 String
  clerkOrgId           String?                   @unique  // VLT-S011-004: direct 1:1
  stripeCustomerId     String?                            // S013 billing wiring
  subscriptionStatus   TenantSubscriptionStatus  @default(free)  // VLT-S015-002

  members          UserTenant[]

  @@schema("public")
  @@allow("read", auth().tenantId == id)              // tenant-scoped: active session must match
  @@allow("read", auth().staffRole != null)           // staff override
  @@deny("delete", true)                              // soft-delete only per P-ARCH-007

  @@index([slug])                                     // URL routing lookup
  @@index([clerkOrgId])                               // Clerk org webhook lookup
}
