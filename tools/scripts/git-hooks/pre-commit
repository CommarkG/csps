#!/usr/bin/env bash
# CSPS Pre-Commit Gate — multi-check
#
# Check 1 (S028 D.3): Zero-laptop scope enforcement
#   Blocks commits with laptop-dependency patterns in .md files.
#   Ratified: D.3 | Approved: Governor S028
#
# Check 2 (S042 EP-ERR-011): Audit-runner freshness after validator edits
#   Warns when tools/validators/*.mjs is staged without audit-runner.md.
#   Pattern: validator behavior change → audit-runner description becomes stale.
#   ADVISORY (exit 0). EP-ERR-011 | B_CATCH_TO_ENGRAVING.
#
# Installation: run tools/scripts/setup-git-hooks.sh once per machine
# Or: cp tools/scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
fi

# Check if node is available
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] SKIP: node not found"
  exit 0
fi

# ── CHECK 1: Zero-laptop scope enforcement (only if .md files staged) ──────────
STAGED_MD=$(git diff --cached --name-only 2>/dev/null | grep '\.md$' || true)
if [ -n "$STAGED_MD" ]; then
  VALIDATOR="${REPO_ROOT}/tools/validators/validate-laptop-patterns.mjs"
  if [ -f "$VALIDATOR" ]; then
    echo "[pre-commit] Running zero-laptop scope check..."
    output=$(node "$VALIDATOR" 2>&1) && exit_code=0 || exit_code=$?
    if [ "$exit_code" -ne 0 ]; then
      echo ""
      echo "⛔ COMMIT BLOCKED — Laptop-dependency patterns detected:"
      echo "$output"
      echo ""
      echo "Fix: Replace local dev patterns with cloud equivalents:"
      echo "  pnpm dev         → vercel --prod (deploy) or Codespace"
      echo "  localhost:PORT   → https://your-project.vercel.app"
      echo "  .env.local       → vercel env add (cloud storage)"
      echo ""
      echo "B_ZERO_LAPTOP_DEPENDENCY (S0 — Constitutional)"
      echo "P-OPER-001 | S028 FSE 5/5"
      exit 1
    fi
    echo "[pre-commit] ✓ Zero-laptop scope check passed"
  fi
fi

# ── CHECK 2: Audit-runner freshness after validator edits ──────────────────────
# If any tools/validators/*.mjs is staged, audit-runner.md must also be staged.
# Pattern from EP-ERR-011: editing a validator changes its behavior/version, making
# the audit-runner description stale. The freshness check in pnpm verify will then
# fail — catch it HERE instead of after commit.
STAGED_VALIDATORS=$(git diff --cached --name-only 2>/dev/null | grep 'tools/validators/.*\.mjs$' || true)
if [ -n "$STAGED_VALIDATORS" ]; then
  STAGED_AUDIT_RUNNER=$(git diff --cached --name-only 2>/dev/null | grep 'audit-runner\.md$' || true)
  if [ -z "$STAGED_AUDIT_RUNNER" ]; then
    echo ""
    echo "⚠ [pre-commit] EP-ERR-011 — validator file(s) staged without audit-runner.md update:"
    while IFS= read -r f; do
      echo "  → $f"
    done <<< "$STAGED_VALIDATORS"
    echo ""
    echo "  If you changed validator behavior or version:"
    echo "  1. Update the entry in: docs/plan/pillar-0-governance/audit-runner.md"
    echo "  2. Run: pnpm audit-runner:split"
    echo "  3. Stage both files before committing"
    echo ""
    echo "  (ADVISORY — commit not blocked. B_CATCH_TO_ENGRAVING | EP-ERR-011)"
    echo ""
  else
    echo "[pre-commit] ✓ Audit-runner freshness check passed (audit-runner.md staged alongside validators)"
  fi
fi

# ── CHECK 3: Monolith slice freshness (principles/contracts/audit-runner) ──────
STAGED_MONOLITHS=$(git diff --cached --name-only 2>/dev/null | grep -E '(behavioral-contracts\.md|principles\.yaml|audit-runner\.md)$' || true)
if [ -n "$STAGED_MONOLITHS" ]; then
  STAGED_SLICES=$(git diff --cached --name-only 2>/dev/null | grep -E '(behavioral-contracts/|principles/principles/|audit-runner/)' || true)
  if [ -z "$STAGED_SLICES" ]; then
    echo ""
    echo "⚠ [pre-commit] Monolith file(s) staged without slices — run split command first:"
    while IFS= read -r f; do echo "  → $f"; done <<< "$STAGED_MONOLITHS"
    echo "  behavioral-contracts.md → pnpm contracts:split"
    echo "  principles.yaml         → pnpm principles:split"
    echo "  audit-runner.md         → pnpm audit-runner:split"
    echo "  (ADVISORY — commit not blocked. validate-slice-freshness.mjs catches this)"
    echo ""
  else
    echo "[pre-commit] ✓ Monolith slice check passed"
  fi
fi

# ── CHECK 5: Delete guard — check staged deletions against invariant-registry ──
# Advisory: if a staged deletion matches an invariant with delete_guard:true, warn.
# Scope: invariant-registry.yaml only (not inheritance-registry — that's OPEN-059).
if [ -f ".claude/hooks/pre-commit-delete-guard.sh" ]; then
  bash ".claude/hooks/pre-commit-delete-guard.sh" || true
fi

# ── CHECK 4: Auto-export plan-api.json when unified-plan.yaml is staged ────────
# If unified-plan.yaml is staged, automatically run pnpm plan:export to keep
# plan-api.json in sync. Stages plan-api.json as part of the same commit.
# Closes the manual sync gap — Planning Hub always reads fresh data after commit.
STAGED_UNIFIED_PLAN=$(git diff --cached --name-only 2>/dev/null | grep 'tools/config/unified-plan.yaml' || true)
if [ -n "$STAGED_UNIFIED_PLAN" ]; then
  echo "[pre-commit] unified-plan.yaml staged — auto-running pnpm plan:export..."
  if command -v pnpm >/dev/null 2>&1 && [ -f "tools/scripts/generate-plan-api.mjs" ]; then
    pnpm plan:export 2>/dev/null && echo "[pre-commit] plan:export succeeded"
    git add tools/data/plan-api.json 2>/dev/null || true
    echo "[pre-commit] ✓ plan-api.json auto-staged alongside unified-plan.yaml"
  else
    echo "[pre-commit] ⚠ pnpm or generate-plan-api.mjs not found — run pnpm plan:export manually"
  fi
fi

# ── CHECK 6: Submodule deliverable gate (CS2 S088-A2 — BLOCKING) ───────────────
# Runs on every commit: untracked submodule source files are silent until deploy.
# Root cause: PHASE-0.3 page committed in parent but untracked in submodule → Vercel
# deployed wrong tree → 404. B_SUBMODULE_DELIVERABLE.
#
# POINTER STALENESS: validate-submodule-deliverable.mjs checks against committed HEAD.
# In pre-commit context: if apps/csps-playground IS staged, the pointer bump is part
# of THIS commit → skip stale-pointer BLOCK (use verify.mjs post-commit instead).
# Untracked source files are ALWAYS blocked.
VALIDATOR_SUB="${REPO_ROOT}/tools/validators/validate-submodule-deliverable.mjs"
if [ -f "$VALIDATOR_SUB" ]; then
  # Pre-commit SCOPE: only check pointer staleness (not untracked source files).
  # Reason: git eol normalization during commit temporarily makes submodule working-tree
  # files appear MODIFIED (CRLF->LF applied by parent .gitattributes eol=lf rules)
  # even when the submodule is genuinely clean. This produces false-positives in the
  # pre-commit hook that cannot be eliminated without removing eol normalization.
  # Resolution: untracked-source check runs in verify.mjs post-commit (reliable).
  # Pre-commit only blocks stale-pointer (parent committing wrong submodule SHA).
  #
  # POINTER CHECK: skip when pointer IS staged (we're updating it right now)
  STAGED_SUB_PTR=$(git diff --cached --name-only 2>/dev/null | grep -E '^apps/' || true)
  if [ -z "$STAGED_SUB_PTR" ]; then
    # No pointer staged — check pointer staleness (parent may have wrong SHA)
    sub_output=$(node "$VALIDATOR_SUB" --pointer-only 2>&1) && sub_exit=0 || sub_exit=$?
    if [ "$sub_exit" -ne 0 ]; then
      echo ""
      echo "⛔ COMMIT BLOCKED — Submodule pointer stale (CS2 pre-commit):"
      echo "$sub_output"
      echo ""
      echo "Fix: update the submodule SHA — git add apps/<submodule-name>"
      echo "B_SUBMODULE_DELIVERABLE | PROTO-S088-A2 | validate-submodule-deliverable.mjs"
      exit 1
    fi
    echo "[pre-commit] ✓ Submodule deliverable check passed (pointer fresh)"
  else
    echo "[pre-commit] ✓ Submodule pointer staged (pointer update in this commit — skipping staleness check)"
  fi
fi

exit 0
