    { "path": "AGENTS.md", "depth": "L1", "why": "hard NOs + governance rules" }
  ],
  "mcp_queries": [
    { "tool": "get_principle", "args": { "id": "P-META-006", "depth": "L1" }, "why": "ZF discipline — verify cycle at open" }
  ],
  "optional_artifacts": [
    { "path": "docs/plan/_handoff/VAULT/closing-summary-S<NNN>.md", "depth": "L1", "trigger": "if prior-session state is unclear" }
  ],
  "estimated_token_cost_L1": 2500,
